# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# Only VITE_-prefixed variables reach the browser. Anything secret must NOT
# have that prefix and must live in the Supabase Edge Function environment
# instead (see docs/SETUP.md).

# --- Safe to ship to the browser -------------------------------------------
# Supabase anon key is designed to be public; row-level security is what
# actually protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- SECRET: set these in Supabase, never here ------------------------------
# supabase secrets set TMDB_API_KEY=...
# supabase secrets set OPENROUTER_API_KEY=...
# supabase secrets set OMDB_API_KEY=...
