{
  "name": "film-society",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:lobby": "node scripts/verify-lobby.mjs",
    "verify:notes": "node scripts/verify-notes.mjs",
    "verify:feedback": "node scripts/verify-feedback.mjs",
    "verify:profile": "node scripts/verify-profile.mjs",
    "build:native": "cross-env CAPACITOR=1 npm run build",
    "sync:native": "npm run build:native && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.6.1",
    "react-router-dom": "^7.7.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.1.0",
    "playwright": "^1.62.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
