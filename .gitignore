node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# Secrets — never commit these
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Supabase local state
supabase/.branches/
supabase/.temp/

# Capacitor
#
# The native projects ARE committed: they carry the app id, permissions,
# icons and signing config, and regenerating them loses all of that. Capacitor
# ships its own .gitignore inside each for build output.
#
# What must not be committed is the copied web build — it is generated by
# `cap sync` from dist/ and would otherwise be a duplicate of every asset,
# churning on every commit.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/capacitor.plugins.json
